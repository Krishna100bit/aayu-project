# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose to the browser

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
STATUS_PAGE_BASE_URL=http://localhost:3000/s   # short public status link, e.g. https://tl.example/s/<status_code>
HOSPITAL_NAME="Demo District Hospital, Jodhpur"

# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/triagelane-events
N8N_SHARED_SECRET=change-me            # sent as X-TL-Secret header in both directions

# --- LLM symptom parser (pick one) ---
LLM_PROVIDER=anthropic                 # anthropic | ollama | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5       # check docs.claude.com for current model strings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Notification providers (used inside n8n credentials, listed here for reference) ---
TELEGRAM_BOT_TOKEN=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER_KEY=                      # MSG91 / Fast2SMS etc. (India needs DLT-registered templates)
