              }
            ]
          }
        ]
      },
      "reason_en": "Pregnant with bleeding, severe headache, vision change, upper stomach pain, reduced baby movement or fit.",
      "reason_hi": "गर्भवती महिला में रक्तस्राव/तेज़ सिर दर्द/नज़र धुंधली/बच्चा कम हिल रहा।",
      "concern": "Obstetric emergency (e.g. pre-eclampsia, abruption)",
      "dept_hint": "OBG",
      "tasks": [
        "measure_bp_now"
      ],
      "status": "clinical_signoff_pending"
    },
    {
      "id": "R09",
      "level": "IMMEDIATE",
      "pack": "core",
