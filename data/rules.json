{
  "version": "0.1.0-draft",
  "status": "Starter rule set drawn from published triage frameworks (NEWS2, ESI, Manchester, SATS, IMCI, WHO dengue). Every rule needs clinical sign-off before any real-world use.",
  "levels": [
    "IMMEDIATE",
    "SOON",
    "ROUTINE"
  ],
  "when_dsl": {
    "tag": "symptom/follow-up tag present",
    "all": "every child true",
    "any": "at least one child true",
    "age_gte": "years, adult age at or above",
    "age_lt_years": "age under N years",
    "pregnant": "boolean",
    "cond": "stored/entered condition id",
    "season": "monsoon|summer|winter (admin setting)",
    "unmatched_text": "free text exists that matched no tag"
  },
  "modifiers": {
    "bump_one_level_if_any": [
      {
        "age_gt": 60
      },
      {
        "age_lt_years": 5
      },
      {
        "pregnant": true
      },
      {
        "cond_any": [
          "diabetes",
          "hypertension",
          "heart_disease",
          "kidney_disease",
          "chronic_lung",
          "immunosuppressed"
        ]
      }
    ],
    "only_if_something_fired": true,
    "cap": "IMMEDIATE",
    "never_applies_to_rules": [
      "Q01",
      "Q02"
    ]
  },
  "safety": {
    "highest_level_wins": true,
    "missing_vitals_with_red_flag": "bump_one_level_and_add_task_measure_vitals",
    "unmatched_text_default": "SOON",
    "engine_error_default": "SOON",
    "only_nurse_can_lower": true,
    "llm_may_only_raise": true
  },
  "time_targets_minutes": {
    "IMMEDIATE": 5,
    "SOON": 30,
    "ROUTINE": 120,
    "note": "placeholders for clinical/admin sign-off"
  },
  "vitals": {
    "scale": "NEWS2 Scale 1 (Royal College of Physicians, 2017)",
    "bands": {
      "rr": [
        {
          "max": 8,
          "score": 3
        },
        {
          "min": 9,
          "max": 11,
          "score": 1
        },
        {
          "min": 12,
          "max": 20,
          "score": 0
        },
        {
          "min": 21,
          "max": 24,
          "score": 2
        },
        {
          "min": 25,
          "score": 3
        }
      ],
      "spo2": [
        {
          "max": 91,
          "score": 3
        },
        {
          "min": 92,
          "max": 93,
          "score": 2
        },
        {
          "min": 94,
          "max": 95,
          "score": 1
        },
        {
          "min": 96,
          "score": 0
        }
      ],
      "sbp": [
        {
          "max": 90,
          "score": 3
        },
        {
          "min": 91,
          "max": 100,
          "score": 2
        },
        {
          "min": 101,
          "max": 110,
          "score": 1
        },
        {
          "min": 111,
          "max": 219,
          "score": 0
        },
        {
          "min": 220,
          "score": 3
        }
      ],
      "hr": [
        {
          "max": 40,
          "score": 3
        },
        {
          "min": 41,
          "max": 50,
          "score": 1
        },
        {
          "min": 51,
          "max": 90,
          "score": 0
        },
        {
          "min": 91,
          "max": 110,
          "score": 1
        },
        {
          "min": 111,
          "max": 130,
          "score": 2
        },
        {
          "min": 131,
          "score": 3
        }
      ],
      "temp_c": [
        {
          "max": 35.0,
          "score": 3
        },
        {
          "min": 35.1,
          "max": 36.0,
          "score": 1
        },
        {
          "min": 36.1,
          "max": 38.0,
          "score": 0
        },
        {
          "min": 38.1,
          "max": 39.0,
          "score": 1
        },
        {
          "min": 39.1,
          "score": 2
        }
      ],
      "consciousness": {
        "alert": 0,
        "confused": 3,
        "voice": 3,
        "pain": 3,
        "unresponsive": 3
      }
    },
    "mapping": {
      "any_single_param_score": {
        "3": "IMMEDIATE",
        "2": "SOON"
      },
      "aggregate": {
        "5+": "IMMEDIATE",
        "3-4": "SOON"
      }
    },
    "extras": [
      {
        "id": "V-BP-HIGH",
        "when": "sbp>=180 or dbp>=120",
        "level": "SOON",
        "escalate_to_immediate_with": [
          "chest_pain",
          "severe_headache",
          "arm_leg_weakness",
          "confusion"
        ],
        "status": "clinical_signoff_pending"
      },
      {
        "id": "V-BP-PREG",
        "when": "pregnant and (sbp>=160 or dbp>=110)",
        "level": "IMMEDIATE",
        "status": "clinical_signoff_pending"
      },
      {
        "id": "V-GLU-LOW",
        "when": "glucose_mgdl<70 and (sweating or drowsy or confusion)",
        "level": "IMMEDIATE",
        "status": "clinical_signoff_pending"
      }
    ],
    "children": {
      "note": "NEWS2 is not validated in children. Use age-banded ranges set by the clinical team; until then child vitals can only raise to SOON (and IMMEDIATE with SpO2<=92 or lethargy), never lower.",
      "reference_normal_ranges_apls_style": {
        "lt_1y": {
          "rr": [
            30,
            40
          ],
          "hr": [
            110,
            160
          ]
        },
        "1_2y": {
          "rr": [
            25,
            35
          ],
          "hr": [
            100,
            150
          ]
        },
        "2_5y": {
          "rr": [
            25,
            30
          ],
          "hr": [
            95,
            140
          ]
        },
        "5_12y": {
          "rr": [
            20,
            25
          ],
          "hr": [
            80,
            120
          ]
        },
        "gt_12y": {
          "rr": [
            15,
            20
          ],
          "hr": [
            60,
            100
          ]
        }
      }
    }
  },
  "rules": [
    {
      "id": "R01",
      "level": "IMMEDIATE",
      "pack": "core",
      "when": {
        "all": [
          {
            "tag": "chest_pain"
          },
          {
            "any": [
              {
                "tag": "sweating"
              },
              {
                "tag": "pain_arm_jaw"
              },
              {
                "tag": "breathless_rest"
              },
              {
                "tag": "nausea"
              },
              {
                "tag": "syncope"
              }
            ]
          }
        ]
      },
      "reason_en": "Chest tightness with sweating, arm/jaw pain, breathlessness or fainting in a {age}-year-old; possible cardiac event.",
      "reason_hi": "सीने में दर्द के साथ पसीना/साँस फूलना/बेहोशी; हृदय संबंधी आपात संभव।",
      "concern": "Possible acute coronary syndrome",
      "dept_hint": "EMERG",
      "tasks": [
        "measure_bp_pulse_spo2",
        "ecg_if_available"
      ],
      "status": "clinical_signoff_pending"
    },
    {
      "id": "R02",
      "level": "IMMEDIATE",
      "pack": "core",
      "when": {
        "any": [
          {
            "tag": "face_droop"
          },
          {
            "tag": "arm_leg_weakness"
          },
          {
            "tag": "slurred_speech"
          },
          {
            "tag": "sudden_vision_loss"
          }
        ]
      },
      "reason_en": "Face droop, one-sided weakness, slurred speech or sudden vision loss; possible stroke. Note the time symptoms started.",
      "reason_hi": "चेहरा टेढ़ा/एक तरफ कमजोरी/बोलने में दिक्कत; लकवे का संदेह।",
      "concern": "Possible stroke (FAST)",
      "dept_hint": "EMERG",
      "tasks": [
        "note_symptom_start_time",
        "measure_glucose"
      ],
      "status": "clinical_signoff_pending"
    },
    {
      "id": "R03",
      "level": "IMMEDIATE",
      "pack": "core",
      "when": {
        "any": [
          {
            "tag": "breathless_rest"
          },
          {
            "tag": "cant_speak_full"
          },
          {
            "tag": "blue_lips"
          }
        ]
      },
      "reason_en": "Breathless at rest, unable to speak full sentences or blue lips; breathing emergency.",
      "reason_hi": "आराम में साँस फूलना/नीले होंठ; साँस का आपात।",
      "concern": "Respiratory distress",
      "dept_hint": "EMERG",
      "tasks": [
        "measure_spo2_rr"
      ],
      "status": "clinical_signoff_pending"
    },
    {
      "id": "R04",
      "level": "IMMEDIATE",
      "pack": "core",
      "when": {
        "all": [
          {
            "tag": "fever"
          },
          {
            "any": [
              {
                "tag": "neck_stiffness"
              },
              {
                "tag": "confusion"
              },
              {
                "tag": "rash_not_fading"
              }
            ]
          }
        ]
      },
      "reason_en": "Fever with stiff neck, confusion or non-fading rash; possible meningitis or sepsis.",
      "reason_hi": "बुखार के साथ गर्दन अकड़न/भ्रम/चकत्ते; गंभीर संक्रमण का संदेह।",
      "concern": "Possible meningitis / sepsis",
      "dept_hint": "EMERG",
      "tasks": [
        "measure_full_vitals"
      ],
      "status": "clinical_signoff_pending"
    },
    {
      "id": "R05",
      "level": "IMMEDIATE",
      "pack": "core",
      "when": {
        "any": [
          {
            "tag": "seizure_now"
          },
          {
            "tag": "unresponsive"
          },
          {
            "tag": "drowsy"
          }
        ]
      },
      "reason_en": "Fit now or recently, or drowsy / not responding.",
      "reason_hi": "दौरा या बेहोशी/बहुत नींद।",
      "concern": "Neurological emergency",
      "dept_hint": "EMERG",
      "tasks": [
        "measure_glucose",
        "measure_full_vitals"
      ],
      "status": "clinical_signoff_pending"
    },
    {
      "id": "R06",
      "level": "IMMEDIATE",
      "pack": "core",
      "when": {
        "any": [
          {
            "tag": "snakebite"
          },
          {
            "tag": "pesticide_exposure"
          },
          {
            "tag": "salivation_twitching"
          },
          {
            "all": [
              {
                "tag": "poisoning"
              }
            ]
          }
        ]
      },
      "reason_en": "Snakebite or poison/pesticide exposure; possible envenomation or poisoning.",
      "reason_hi": "साँप का काटना या ज़हर/कीटनाशक का संपर्क।",
      "concern": "Envenomation or poisoning (incl. organophosphate)",
      "dept_hint": "EMERG",
      "tasks": [
        "note_substance_and_time",
        "measure_full_vitals"
      ],
      "status": "clinical_signoff_pending"
    },
    {
      "id": "R07",
      "level": "IMMEDIATE",
      "pack": "core",
      "when": {
        "any": [
          {
            "tag": "heavy_bleeding"
          },
          {
            "tag": "vomiting_blood"
          },
          {
            "tag": "black_stool"
          },
          {
            "all": [
              {
                "tag": "head_injury"
              },
              {
                "any": [
                  {
                    "tag": "drowsy"
                  },
                  {
                    "tag": "persistent_vomiting"
                  },
                  {
                    "tag": "confusion"
                  },
                  {
                    "tag": "unresponsive"
                  }
                ]
              }
            ]
          }
        ]
      },
      "reason_en": "Heavy bleeding, vomiting blood, black stools or head injury with drowsiness/vomiting.",
      "reason_hi": "तेज़ रक्तस्राव/खून की उल्टी/सिर की चोट के साथ उल्टी।",
      "concern": "Haemorrhage or major trauma",
      "dept_hint": "EMERG",
      "tasks": [
        "measure_bp_pulse"
      ],
      "status": "clinical_signoff_pending"
    },
    {
      "id": "R08",
      "level": "IMMEDIATE",
      "pack": "core",
      "when": {
        "all": [
          {
            "pregnant": true
          },
          {
            "any": [
              {
                "tag": "vaginal_bleeding"
